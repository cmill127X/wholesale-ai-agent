FROM mcr.microsoft.com/playwright/python:v1.55.0-noble
WORKDIR /app
COPY requirements-browser.txt /app/requirements-browser.txt
RUN pip install --no-cache-dir -r /app/requirements-browser.txt
COPY browser_worker.py /app/browser_worker.py
ENV BROWSER_HEADLESS=1
CMD ["sh", "-c", "uvicorn browser_worker:app --host 0.0.0.0 --port ${PORT:-10000}"]
